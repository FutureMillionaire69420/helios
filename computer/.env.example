# Copy to .env on the computer/server. Keep it private once filled in.
LEADER_WALLET=4vw54BmAogeRV3vPKWyFet5yf8DTLcREzdSzx4rw9Ud9
LEADER_LABEL=Decu
HELIUS_API_KEY=
# Solscan Pro API key (https://solscan.io/apis). Second, independent watcher on the leader:
# catches trades Helius missed, cross-checks the parser, names coins in alerts, SOL price.
SOLSCAN_API_KEY=
SOLSCAN_POLL_MS=10000
# Helius signature pages per backup poll (1000 each). His address gets ~250 tx/s of spam,
# so this only covers seconds; Solscan covers the full window. Default 1 with Solscan, 3 without.
HELIUS_POLL_PAGES=
# Auto-sell style exit rule: sell EVERYTHING at his first sell. MAX_HOLD_SEC is the gain-gate time,
# counted from DECU'S buy (his on-chain time): see GAIN_GATE_PCT below. 0 = no gate.
SELL_ALL_ON_LEADER_SELL=true
MAX_HOLD_SEC=15
# FAST_PATH=true buys straight from the websocket logs (processed commitment), ~0.5-1.5 s sooner.
FAST_PATH=true
# Phone check-in that the bot is healthy, every N hours (outages are alerted right away).
HEALTH_ALERT_HOURS=12
# BAND in study alerts: profit if each copy were this % of what Decu spent (study only, not trading).
BAND_PCT=10
# Most fetches per Helius poll while the websocket is down (his address is flooded with spam).
HELIUS_POLL_MAX=25
# His trades are version-1 transactions; leave at 1.
MAX_TX_VERSION=1
RPC_URL=
WS_URL=
# For TRUE unattended trading, the bot signs locally with this burner wallet key.
# Never use your main Phantom wallet here. Never paste this into chat.
PRIVATE_KEY=
# Explicit Phantom alias (optional; setup --live fills both fields).
PHANTOM_PRIVATE_KEY=
# Burner Phantom Solana address supplied by the user. The private key must derive this exact address.
PHANTOM_WALLET_ADDRESS=
DRY_RUN=true

# Set 0.0.0.0 for LAN access or a server behind HTTPS.
PORT=3000
DASHBOARD_HOST=127.0.0.1
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_TOKEN=

# fixed = BUY_SOL every copy (your rule). proportional = share of his wallet; with a small wallet that means
# 0.005-0.008 SOL buys where fees eat 25-40% of each trade, so it is NOT recommended.
SIZING_MODE=fixed
COPY_MULTIPLIER=1
BUY_SOL=0.1
MAX_BUY_SOL=0.1
MIN_BUY_SOL=0.005
MIN_LEADER_BUY_USD=50
ONE_BUY_PER_MINT=true
PUMP_ONLY=true
# Daily spending cap in SOL. 0 = NO CAP (default): the bot buys every copy the wallet can pay for.
DAILY_CAP_SOL=0
MIN_SOL_RESERVE=0.02
TIMEZONE=America/New_York

# Trading style (the bot always buys when he buys; Pause stops buying). Starting value only;
# after that the dashboard "Trading style" buttons or `node copybot.mjs style auto|manual` decide.
# AUTO_COPY=true:  auto buy + AUTO sell (sells the same share he sells)
# AUTO_COPY=false: auto buy + MANUAL sell (SOLD alert, you sell in Phantom)
AUTO_COPY=true
# false = never sell; you get a priority alert the moment he sells a coin you hold (your choice).
# true  = the bot sells the same share he sells, right after him (lost money in the 2026-10-07 paper tests).
AUTO_SELL=false
MAX_SIGNAL_AGE_SEC=30
MAX_SELL_SIGNAL_AGE_SEC=300
EXECUTOR=pumpportal
# 10% failed often on his fast coins in testing; 20% is the tested setting.
SLIPPAGE_PCT=20
# FEES. FEE_MODE=max (default): every buy AND sell pays the top of the market at that moment, so it lands
# as early as possible. Priority fee = Helius estimate at PRIORITY_LEVEL for pump.fun; tip = Jito's
# TIP_PERCENTILE of recently landed tips. Refreshed every FEE_REFRESH_SEC in the background (never
# looked up during a trade). Never above the caps below; when an estimate is missing the CAP is paid.
# Cost at the caps: 0.008 SOL per side = up to ~16% round trip on a 0.1 SOL trade. Paying more than
# the top of the market does not land faster. FEE_MODE=fixed pays PRIORITY_FEE_SOL + TIP_SOL always.
FEE_MODE=max
PRIORITY_LEVEL=VeryHigh
TIP_PERCENTILE=landed_tips_99th_percentile
PRIORITY_FEE_MAX_SOL=0.003
TIP_MAX_SOL=0.005
FEE_REFRESH_SEC=10
# The minimum (and the FEE_MODE=fixed amount):
PRIORITY_FEE_SOL=0.0005
TIP_SOL=0.001
# Helius Sender. On a server use the REGIONAL one nearest to it (plain http, lowest latency; the API key is
# never sent over http): Render Oregon -> http://slc-sender.helius-rpc.com/fast (Salt Lake City).
SENDER_URL=https://sender.helius-rpc.com/fast
# LIVE: keep the Sender connection open between buys with a free ping every N seconds (0 = off)
SENDER_PING_SEC=3
SEND_RPC_URLS=
REBROADCAST=true
POLL_INTERVAL_MS=5000
# v2 ALWAYS validates and simulates before a real send.
SIMULATE_BEFORE_SEND=true
JUPITER_API_KEY=

# Phone alerts: install the ntfy app and subscribe to this exact (long, random) topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Free ntfy.sh has a daily message limit; a (free) ntfy account access token lifts it.
NTFY_TOKEN=

PAPER_BALANCE_SOL=1.65   # ~$200, your test budget
PAPER_LAND_MS=1000

# SPEED: one extra Helius websocket PUSHES the current block, "your transaction confirmed" and every
# price change of a held coin (instead of asking). false = polling only (slower, same results).
PUSH_STREAM=true
# confirmation polling backup: every CONFIRM_POLL_MS, or CONFIRM_POLL_MS_PUSH while the push is live
CONFIRM_POLL_MS=300
CONFIRM_POLL_MS_PUSH=1000
# SOL/USD is kept fresh in the background (a buy never waits for it)
SOL_PRICE_REFRESH_SEC=15
# A Decu buy already acted on from the websocket fetches its full transaction this much later (it can't
# exist sooner), so the download never competes with the bot's own buy. His sells are fetched at once.
FULL_PATH_DELAY_MS=500
# State defaults: engine-paper.json / engine-live.json / engine-demo.json.
# Journal: trades.log. Never delete live state to resolve pending trades.
# v1 ntfy/report/backtest features are legacy. Use the dashboard for v2 results.

# FASTEST BUYS: build the pump.fun buy inside the bot from Decu's trade event (no PumpPortal round
# trip, cached blockhash). Every buy is still fully checked and simulated before sending. Falls back
# to PumpPortal automatically. `check` verifies it with your own wallet before you go live.
LOCAL_BUILD=true

# EXIT RULES (prices each held coin every second):
# down STOP_LOSS_PCT at any moment -> sell everything (both styles; STOP_LOSS_MANUAL=false = auto only)
STOP_LOSS_PCT=20
# (paper also tests the stop counted on your money (-20% of what you paid, test c) and the holder rule
#  as a momentum exit (test d) on every trade; the real stop above ALWAYS sells.)
# entry = measure the coin's own move from the bot's entry price (fees ignored); cost = from cost
STOP_LOSS_FROM=entry
STOP_LOSS_MANUAL=true
# auto-sell style: reached +GAIN_GATE_PCT within MAX_HOLD_SEC of Decu's buy -> sell then;
# never reached it -> hold until Decu sells. HOLD_LIMIT_SEC = sell no matter what.
GAIN_GATE_PCT=15
HOLD_LIMIT_SEC=600

# ENTRY-PREMIUM FILTER: skip a buy priced more than this % above Decu's own price (default 15).
# PRICE vs PRICE: the bot's price per token into the curve vs his (fees are counted separately).
# FAIL-CLOSED: no Decu price or no current price = no buy. Enforced on-chain by the local builder and
# checked before signing on the PumpPortal path. 0 = off.
MAX_PAY_ABOVE_DECU_PCT=15
# Every alert also says what these other limits would have done (TAKE / SKIP), and the dashboard
# compares them on the same trades. Report only: they never change what the bot buys.
FILTER_REPORT_PCTS=10,25
# Paper uses the same filter unless set here (0 = paper buys everything). Skipped buys are studied anyway.
PAPER_MAX_PAY_PCT=
# At most this many coins open at once (held + being bought). A Decu buy over the limit is skipped and studied.
MAX_OPEN_POSITIONS=2
# Daily spending cap in US dollars (converted with Decu's own trade price). 0 = no cap.
DAILY_CAP_USD=600
# His SELL is acted on only once confirmed on-chain (~0.4 s after the fast path). true = act on unconfirmed sells.
FAST_PATH_SELLS=false
# STOP-LOSS RELIABILITY: price every MONITOR_MS; a price check gives up after QUOTE_TIMEOUT_MS;
# PRICE_FAIL_ALERT failed checks in a row = alert, PRICE_FAIL_SELL = sell anyway (0 = never sell blind).
MONITOR_MS=500
QUOTE_TIMEOUT_MS=1500
PRICE_FAIL_ALERT=3
PRICE_FAIL_SELL=6
# Sells allow this much slippage so a falling coin still fills; failed sells are retried SELL_RETRIES times
# at once, then CAN'T SELL is alerted and the bot keeps trying.
SELL_SLIPPAGE_PCT=35
SELL_RETRIES=3
# CIRCUIT BREAKERS (new buys only): BUY_FAIL_BREAKER failed buys in a row -> no new buys for
# BUY_FAIL_COOLDOWN_MIN minutes; Helius websocket down for STALE_DATA_SEC -> no new buys until it is back.
BUY_FAIL_BREAKER=3
BUY_FAIL_COOLDOWN_MIN=10
STALE_DATA_SEC=30
# Phone alerts for Decu buys the bot skipped (always recorded and on the dashboard):
# report = only those inside the widest FILTER_REPORT_PCTS (25%), true = all, false = none.
SKIPPED_ALERTS=report
# HOLDER MONEY RULE (paper test d + a SAFE / RISKY line on every alert; never changes a trade):
# the coins held by every wallet EXCEPT the dev (and the bonding curve), in dollars, must be at least
# this much for each market cap. marketcap:dollars pairs. Default: $1000 at a $10k market cap,
# $2500 at $20k, $4000 at $30k.
HOLDER_RULES=10000:1000,20000:2500,30000:4000
# Optional: no new buys for the rest of the day after closed trades lose this much SOL. 0 = off.
DAILY_LOSS_LIMIT_SOL=0
# Chart pictures on phone alerts (QuickChart.io; only % numbers and the coin name are sent).
CHARTS=true
# THE BRAIN (learn.mjs): a learning report every N studied trades (patterns, predictions, advisor,
# go-live readiness) and a daily digest every N hours. 0 = off.
LEARN_REPORT_EVERY=10
LEARN_DIGEST_HOURS=24
# Extra trading program ids to treat as Decu trades (comma separated).
EXTRA_TRADE_PROGRAMS=
